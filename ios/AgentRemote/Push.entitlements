<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
	<key>aps-environment</key><string>$(APNS_ENVIRONMENT)</string>
	<!-- Per-Mac secrets shared with the Notification Service Extension, which decrypts rich alerts. -->
	<key>keychain-access-groups</key><array><string>$(AppIdentifierPrefix)com.agentremote.shared</string></array>
</dict></plist>
